@page "/insert"

@using DataLibrary
@using Gaming_Backlog.Models
@using Gaming_Backlog.Tools
@using Microsoft.Extensions.Configuration
@inject IDataAccess _data
@inject IConfiguration _config;
@inject IGameValidator _validator;

<PageTitle>Insert Game</PageTitle>

<h3>Insert Game</h3>

<EditForm Model="_gameInput" OnValidSubmit="InsertGame">

    <DataAnnotationsValidator />

    <ValidationSummary />
<table class="table table-bordered">
    <tr class="p-3">
        <th>Title</th>
        <th>Release Year</th>
        <th>Genres</th>
        <th>Interest</th>
    </tr>

    <tbody>
        <tr>
            <td>
                <InputText @bind-Value="_gameInput.Title"/>
                <ValidationMessage For="@(() => _gameInput.Title)" />
            </td>
            <td>
                <InputNumber @bind-Value="_gameInput.ReleaseYear" />
                <ValidationMessage For="@(() => _gameInput.ReleaseYear)"/>
            </td>
            <td>
                <select multiple @bind="_genresInput">
                    @foreach(GenresModel genre in _availableGenres)
                            {
                                <option value=@genre.Id>@genre.Name</option>
                            }
                </select> 
            </td>
            <td>
                <InputSelect @bind-Value="_gameInput.Interest">
                    @for(int i = 1; i < 6; i++)
                    {
                        <option value=@i>@i</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => _gameInput.Interest)"/>
            </td>
        </tr>
    </tbody>
    
</table>
<div class="p-lg-5 text-center">
    <button type="submit" class="btn btn-secondary" @onclick="InsertGame">Execute</button>
</div>
</EditForm>


@code{
    private GamesModel _gameInput = new();
    private List<GenresModel> _availableGenres = new();
    private string[] _genresInput = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        string genresSql = "SELECT * FROM genres";

        _availableGenres = await _data.LoadData<GenresModel, dynamic>(genresSql, new { }, _config.GetConnectionString("default"));
    }
    private async Task InsertGame()
    {
        string title = _gameInput.Title;
        int? date = _gameInput.ReleaseYear;
        string[] genres = _genresInput;
        int interest = _gameInput.Interest;

        string sqlGameEntry = "INSERT INTO games(title, date, interest) VALUES(@title, @date, @interest)";

        int game_id = await _data.InsertGameAndReturnId(sqlGameEntry, new { title, date, interest }, _config.GetConnectionString("default"));

        try
        {
            for (int i = 0; i < genres.Length; i++)
            {
                var genre_id = _availableGenres.Where(availableGenre => availableGenre.Id.ToString() == genres[i]).Select(genre => genre.Id).First();
                await _data.SaveData("INSERT INTO games_genres(game_id, genre_id) VALUES(@game_id, @genre_id)", new { game_id, genre_id }, _config.GetConnectionString("default"));
            }
        }
        catch(Exception ex)
        {
            await _data.SaveData("DELETE FROM games WHERE title LIKE '@title'", new { }, _config.GetConnectionString("default"));
        }

    }
}